{
  "expo": {
    "name": "Musicaleando",
    "slug": "musicaleando",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14111F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musicaleando.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.musicaleando.app",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#14111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14111F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#14111F"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Musicaleando necesita acceso a tus fotos para agregarlas a tu álbum de conciertos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#14111F"
        }
      ]
    ],
    "owner": "clauliz",
    "extra": {
      "eas": {
        "projectId": "b50abde3-d4d2-4678-9258-b594da968bdf"
      }
    }
  }
}
